# Operator configuration for the migracia scripts.
#
# Copy to ${HOME}/.secret/local_migration.env on the head node, as vgmigr,
# and fill in the real values. This file is read by:
#   01-migr-one-propagade-x.sh
#   migr-one-blocked.sh
#
# Nothing here belongs in the repository: the monitor endpoint and its token
# are operational information about how we detect blocking.

# Reachability monitor used by migr-one-blocked.sh to ask whether an address
# is reachable from inside the censored country. No default -- the script
# refuses to run without it.
MONITOR_URL="https://monitor.example.org/api/v1/check"
